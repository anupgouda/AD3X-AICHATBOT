  "cards": [
    {
      "dot": "cyan",
      "title": "Knowledge ingestion",
      "items": [
        "PDF text is extracted with PyPDF2; web pages are fetched with requests and parsed with BeautifulSoup.",
        "RecursiveCharacterTextSplitter uses chunk_size 10,000 and overlap 1,000.",
        "Chunks are embedded with gemini-embedding-001 and stored in the FAISS vector index."
      ]
    },
    {
      "dot": "violet",
      "title": "Question answering",
      "items": [
        "A question from Streamlit or Telegram is converted to a query embedding using the same gemini-embedding-001 embedding model through the LangChain retrieval path.",
        "The similarity-search/retriever operation compares the query against FAISS and requests k=4 relevant documents.",
        "FAISS returns the top-4 document chunks to the Context Builder."
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounded generation",
      "items": [
        "The Context Builder joins the retrieved document page_content into one context.",
        "Gemini receives the context together with the original user question.",
        "The prompt instructs Gemini to answer only from the provided context and not invent information."
      ]
    }
  ]
